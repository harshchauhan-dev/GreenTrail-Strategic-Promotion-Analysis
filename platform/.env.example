# ============================================================
# GreenTrail Live Intelligence Platform — Environment Config
# Copy this to .env and fill in real values
# NEVER commit .env to source control
# ============================================================

# ─── App ────────────────────────────────────────────────────
APP_ENV=development                    # development | staging | production
APP_NAME="GreenTrail Intelligence"
APP_VERSION=1.0.0
DEBUG=true
DEMO_MODE=true                         # Set to false when real connectors are configured

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://greentrail:greentrail_dev_password@localhost:5432/greentrail
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=30                     # seconds

# ─── Auth / JWT ─────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-256-bit-random-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── CORS ───────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── AI / OpenAI ────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.2
AI_ENABLED=false                       # Set to true when API key is configured

# ─── Demo Connector ─────────────────────────────────────────
DEMO_EVENT_RATE_PER_MINUTE=120        # events simulated per minute in demo mode
DEMO_COMPANIES=7

# ─── Real Company Connector (filled by admin UI) ─────────────
# COMPANY_API_URL=
# COMPANY_API_KEY=
# COMPANY_API_SECRET=
# COMPANY_WEBHOOK_SECRET=

# ─── CRM Connector ───────────────────────────────────────────
# CRM_TYPE=salesforce                  # salesforce | hubspot | zoho
# CRM_API_URL=
# CRM_API_KEY=

# ─── Email / Alerts ──────────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# ALERT_EMAIL_FROM=alerts@greentrail.app

# ─── Slack ───────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100
AI_RATE_LIMIT_PER_MINUTE=20

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json                        # json | console

# ─── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME="GreenTrail Intelligence"
NEXT_PUBLIC_DEMO_MODE=true
